{
  "name": "negocio360-escritorio",
  "productName": "Negocio360",
  "version": "2.0.0-piloto.2",
  "description": "Negocio360 — programa de escritorio para Windows con modo sin conexión (versión piloto)",
  "main": "src/main/main.js",
  "author": "Negocio360",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "pruebas": "node --test \"pruebas/unitarias/**/*.test.js\"",
    "humo": "xvfb-run -a node pruebas/electron/humo.js",
    "librerias": "node herramientas/inventario-librerias.js",
    "instalar-electron": "bash herramientas/instalar-electron.sh",
    "empaquetar": "node herramientas/empaquetar-web.js",
    "iniciar": "npm run -s empaquetar && electron .",
    "e2e": "npm run -s empaquetar && xvfb-run -a node --test \"pruebas/e2e/**/*.test.js\"",
    "instalador-win": "npm run -s empaquetar && electron-builder --win --publish never",
    "referencia": "node pruebas/referencia-web/capturar.js && node pruebas/referencia-web/generar-sql.js --sin-migracion pruebas/referencia-web/capturas.json build/prueba-centavo.sql",
    "navegador": "npm run -s empaquetar && node --test --test-concurrency=1 \"pruebas/navegador/**/*.test.js\""
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@fontsource/sora": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@zxing/browser": "0.1.5",
    "chart.js": "4.4.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "html2canvas": "1.4.1",
    "jsbarcode": "3.11.6",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.7.1",
    "leaflet": "1.9.4",
    "lucide": "1.52.0",
    "playwright": "1.56.1",
    "xlsx": "0.18.5"
  }
}
